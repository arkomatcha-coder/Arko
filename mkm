];
let quizInitialized = false;
let selectedMatchChip = null;

function initQuiz(){
 if(quizInitialized) return;
 quizInitialized = true;
 document.querySelectorAll(".quiz-tab").forEach(btn=>btn.addEventListener("click",()=>{
   document.querySelectorAll(".quiz-tab").forEach(x=>x.classList.toggle("active",x===btn));
   ["mc","essay","match"].forEach(k=>$("quiz"+k.charAt(0).toUpperCase()+k.slice(1)).classList.toggle("hidden",btn.dataset.quiz!==k));
 }));
 renderMc(); renderEssay(); renderMatch();
 $("submitMc").addEventListener("click",gradeMc);
 $("resetMc").addEventListener("click",renderMc);
 $("toggleEssayGuide").addEventListener("click",()=> $("essayGuide").classList.toggle("hidden"));
 $("resetEssay").addEventListener("click",()=>{renderEssay();$("essayGuide").classList.add("hidden");});
 $("checkMatch").addEventListener("click",gradeMatch);
 $("resetMatch").addEventListener("click",renderMatch);
}

function renderMc(){
 $("mcResult").innerHTML="";
 $("mcProgress").style.width="0%";
 $("mcQuestions").innerHTML=mcData.map((q,i)=>`
 <div class="quiz-card" data-mcq="${i}">
  <div class="quiz-question">${i+1}. ${q.q}</div>
  ${q.o.map((op,j)=>`<label class="quiz-option"><input type="radio" name="mc${i}" value="${j}"><span>${String.fromCharCode(65+j)}. ${op}</span></label>`).join("")}
  <div class="quiz-feedback hidden" id="mcFeedback${i}"></div>
 </div>`).join("");
 $("mcQuestions").querySelectorAll("input").forEach(inp=>inp.addEventListener("change",()=>{
  const done=mcData.filter((q,i)=>document.querySelector(`input[name="mc${i}"]:checked`)).length;
  $("mcProgress").style.width=(done/mcData.length*100)+"%";
 }));
}
function gradeMc(){
 let score=0, unanswered=0;
 mcData.forEach((q,i)=>{
  const chosen=document.querySelector(`input[name="mc${i}"]:checked`);
  const fb=$("mcFeedback"+i); fb.classList.remove("hidden","correct","wrong");
  if(!chosen){unanswered++;fb.classList.add("wrong");fb.innerHTML="<strong>Belum dijawab.</strong> "+q.e;return;}
  const ok=Number(chosen.value)===q.a;
  if(ok)score++;
  fb.classList.add(ok?"correct":"wrong");
  fb.innerHTML=`<strong>${ok?"Benar.":"Belum tepat."}</strong> Jawaban: ${String.fromCharCode(65+q.a)}. ${q.o[q.a]}<br>${q.e}`;
 });
 const pct=Math.round(score/mcData.length*100);
 $("mcResult").innerHTML=`<div class="quiz-score"><h3>Hasil Latihan</h3><strong>${score} dari ${mcData.length} benar (${pct}/100)</strong><p>${unanswered?unanswered+" soal belum dijawab. ":""}${pct>=80?"Pemahamanmu sudah sangat baik.":pct>=60?"Terus tingkatkan pemahaman dengan membaca pembahasan.":"Pelajari kembali materi dan pembahasannya, lalu coba lagi."}</p></div>`;
}
function renderEssay(){
 $("essayQuestions").innerHTML=essayData.map((q,i)=>`<div class="quiz-card"><div class="quiz-question">${i+1}. ${q.q}</div><textarea id="essayAnswer${i}" placeholder="Tuliskan langkah penyelesaian dan jawabanmu..."></textarea></div>`).join("");
 $("essayGuide").innerHTML="<h3>Pedoman Jawaban</h3>"+essayData.map((q,i)=>`<div class="quiz-feedback"><strong>Soal ${i+1}</strong><br>${q.a}</div>`).join("");
}
function shuffle(a){const x=[...a];for(let i=x.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]];}return x;}
function renderMatch(){
 selectedMatchChip=null;
 $("matchResult").innerHTML="";
 const defs=shuffle(matchData.map((x,i)=>({id:i,def:x.def})));
 $("matchBank").innerHTML=defs.map(x=>`<button type="button" draggable="true" class="match-chip" data-match-id="${x.id}">${x.def}</button>`).join("");
 $("matchQuestions").innerHTML=matchData.map((x,i)=>`<div class="match-row"><div class="match-term">${i+1}. ${x.term}</div><div class="match-target" data-target="${i}" tabindex="0">Letakkan pasangan jawaban di sini</div></div>`).join("");
 document.querySelectorAll(".match-chip").forEach(chip=>{
  chip.addEventListener("dragstart",e=>e.dataTransfer.setData("text/plain",chip.dataset.matchId));
  chip.addEventListener("click",()=>{
   if(selectedMatchChip) selectedMatchChip.classList.remove("selected");
   selectedMatchChip=chip; chip.classList.add("selected");
  });
 });
 document.querySelectorAll(".match-target").forEach(target=>{
  target.addEventListener("dragover",e=>{e.preventDefault();target.classList.add("over");});
  target.addEventListener("dragleave",()=>target.classList.remove("over"));
  target.addEventListener("drop",e=>{e.preventDefault();target.classList.remove("over");placeMatch(target,Number(e.dataTransfer.getData("text/plain")));});
  target.addEventListener("click",()=>{
   if(selectedMatchChip){placeMatch(target,Number(selectedMatchChip.dataset.matchId));selectedMatchChip.classList.remove("selected");selectedMatchChip=null;}
  });
  target.addEventListener("keydown",e=>{if((e.key==="Enter"||e.key===" ")&&selectedMatchChip){e.preventDefault();placeMatch(target,Number(selectedMatchChip.dataset.matchId));}});
 });
}
function placeMatch(target,id){
 const chip=document.querySelector(`.match-chip[data-match-id="${id}"]`);
 if(!chip || chip.classList.contains("used")) return;
 const previous=target.dataset.answer;
 if(previous!==undefined){const old=document.querySelector(`.match-chip[data-match-id="${previous}"]`);if(old)old.classList.remove("used");}
 target.dataset.answer=String(id);target.textContent=matchData[id].def;
 chip.classList.add("used");
}
function gradeMatch(){
 let correct=0,filled=0;
 document.querySelectorAll(".match-target").forEach(t=>{
  const id=t.dataset.answer;
  t.style.borderColor="#94a3b8";
  if(id!==undefined){filled++;if(Number(id)===Number(t.dataset.target)){correct++;t.style.borderColor="#059669";}else{t.style.borderColor="#ea580c";}}
 });
 $("matchResult").innerHTML=`<div class="quiz-score"><h3>Hasil Mencocokkan</h3><strong>${correct} dari ${matchData.length} pasangan benar</strong><p>${filled<matchData.length?`Masih ada ${matchData.length-filled} pasangan yang belum diisi. `:""}Cocokkan kembali pasangan yang belum tepat, kemudian periksa ulang.</p></div>`;
}
'''

