function bukaFitur(nama) {
  $("comingTitle").textContent = nama;
  showPage("comingPage");
}

async function getProfile(user) {
  const snap = await getDoc(doc(db, "users", user.uid));
  if (!snap.exists()) throw new Error("Profil akun tidak ditemukan di Firestore.");
  return snap.data();
}

async function verifyAccount(user) {
  const profile = await getProfile(user);

  if (profile.role === "admin") return { role: "admin", profile };

  if (profile.role !== "guru") {
    throw new Error("Akun ini tidak terdaftar sebagai guru atau admin.");
  }
  if (profile.status === "pending") {
    throw new Error("Pendaftaranmu masih menunggu persetujuan admin.");
  }
  if (profile.status === "rejected") {
    throw new Error("Pendaftaran guru ditolak. Hubungi admin jika perlu klarifikasi.");
  }
  if (profile.status === "disabled") {
    throw new Error("Akses akunmu sedang dinonaktifkan oleh admin.");
  }
  if (profile.status !== "approved") {
    throw new Error("Status akun belum valid. Hubungi admin ADALUANG.");
  }
  return { role: "guru", profile };
}

function authMessage(error) {
  const messages = {
    "auth/invalid-credential": "Email atau password salah.",
    "auth/invalid-email": "Format email tidak valid.",
    "auth/email-already-in-use": "Email ini sudah terdaftar. Silakan login.",
    "auth/weak-password": "Password terlalu lemah. Gunakan minimal 6 karakter.",
    "auth/too-many-requests": "Terlalu banyak percobaan. Coba lagi nanti.",
    "auth/network-request-failed": "Koneksi internet bermasalah.",
    "auth/operation-not-allowed": "Aktifkan metode Email/Password di Firebase Authentication.",
    "permission-denied": "Akses database ditolak. Periksa Firestore Security Rules."
  };
  return messages[error.code] || error.message || "Terjadi kesalahan.";
}

$("loginForm").addEventListener("submit", async event => {
  event.preventDefault();
  showError("");
  $("registerMessage").textContent = "";

  const identity = $("fullName").value.trim();
  const passwordOrCode = $("accessCode").value;

  if (selectedRole === "murid") {
    if (passwordOrCode !== STUDENT_ACCESS_CODE) {
      showError("Kode akses tidak sesuai. Silakan periksa kembali.");
      return;
    }
    activeUser = null;
    activeRole = "murid";
    studentName = identity;
    buildDashboard();
    startMaterialsListener();
    return;
  }

  const button = $("loginButton");
  button.disabled = true;
  button.textContent = "Memeriksa akun...";

  try {
    await signInWithEmailAndPassword(auth, identity, passwordOrCode);
    // onAuthStateChanged memeriksa status akun sebelum membuka dashboard.
  } catch (error) {
    showError(authMessage(error));
  } finally {
    button.disabled = false;
    button.textContent = "Masuk ke Ruang Guru →";
  }
});

$("registerForm").addEventListener("submit", async event => {
  event.preventDefault();
  showError("");
  $("registerMessage").textContent = "";

  const nama = $("registerName").value.trim();
  const email = $("registerEmail").value.trim().toLowerCase();
  const password = $("registerPassword").value;
  const password2 = $("registerPassword2").value;

  if (!nama) {
    showError("Nama lengkap wajib diisi.");
    return;
  }
  if (password.length < 6) {
    showError("Password minimal 6 karakter.");
    return;
  }
  if (password !== password2) {
    showError("Konfirmasi password tidak sama.");
    return;
  }

  const button = $("registerSubmit");
  button.disabled = true;
  button.textContent = "Mengirim pendaftaran...";
  registering = true;

  let createdUser = null;
  try {
    const credential = await createUserWithEmailAndPassword(auth, email, password);
    createdUser = credential.user;

    await setDoc(doc(db, "users", createdUser.uid), {
      nama,
      email,
      role: "guru",
      status: "pending",
      createdAt: serverTimestamp()
    });

    await signOut(auth);
    $("registerForm").reset();
    setLoginMode("login");
    $("registerMessage").textContent =
      "Pendaftaran berhasil dikirim! Tunggu persetujuan admin sebelum login.";
  } catch (error) {
    console.error("Pendaftaran gagal:", error);
    if (createdUser && auth.currentUser) {
      await signOut(auth).catch(() => {});
    }
    showError("Pendaftaran gagal: " + authMessage(error) +
      " Jika akun sudah terbentuk tetapi profil gagal dibuat, hubungi admin untuk pemeriksaan.");
  } finally {
    registering = false;
    button.disabled = false;
    button.textContent = "Kirim Pendaftaran →";
  }
});

window.logout = async function() {
  stopMaterialsListener();
  stopUsersListener();
  try {
    if (auth.currentUser) await signOut(auth);
  } catch (error) {
    showError("Gagal keluar: " + authMessage(error));
    return;
  }
  clearSession();
  selectedRole = "";
  showPage("home");
};

function bukaMateri() {
  if (activeRole !== "guru" && activeRole !== "admin" && activeRole !== "murid") {
    showPage("home");
    return;
  }
  $("formMateri").classList.toggle("hidden", activeRole !== "guru" && activeRole !== "admin");
  $("materialError").textContent = "";
  $("materialError").className = "error";
  showPage("materiPage");
  renderMaterials();
}

function startMaterialsListener() {
  stopMaterialsListener();
  $("jumlahMateri").textContent = "Memuat materi...";
  $("daftarMateri").replaceChildren();

  unsubscribeMaterials = onSnapshot(collection(db, "materials"), snapshot => {
    materials = snapshot.docs.map(d => ({ id: d.id, ...d.data() }));
    materials.sort((a, b) => (b.createdAt?.toMillis?.() || 0) - (a.createdAt?.toMillis?.() || 0));
    renderMaterials();
  }, error => {
    console.error("Gagal memuat materi:", error);
    $("jumlahMateri").textContent = "Materi belum dapat dimuat.";
    $("daftarMateri").replaceChildren();
    const empty = document.createElement("div");
    empty.className = "empty-state";
    empty.textContent = "Tidak dapat memuat materi. Periksa Firestore Rules dan koneksi internet.";
    $("daftarMateri").appendChild(empty);
  });
}

function renderMaterials() {
  const list = $("daftarMateri");
  list.replaceChildren();
  $("jumlahMateri").textContent = materials.length + " materi tersedia";

  if (!materials.length) {
    const empty = document.createElement("div");
    empty.className = "empty-state";
    empty.textContent = "Belum ada materi yang tersedia.";
    list.appendChild(empty);
    return;
  }

  materials.forEach(item => {
    const card = document.createElement("article");
    card.className = "material-card";
    const tag = document.createElement("span");
    tag.className = "material-tag";
    tag.textContent = "MATERI PEMBELAJARAN";
    const title = document.createElement("h3");
    title.textContent = item.judul || "Tanpa judul";
    const desc = document.createElement("p");
    desc.textContent = item.deskripsi || "";
    const author = document.createElement("p");
    author.textContent = "Dibuat oleh: " + (item.pembuat || "Guru");
    card.append(tag, title, desc, author);

    const actions = document.createElement("div");
    actions.className = "material-actions";
    const url = safeUrl(item.link || "");

    if (url) {
      const open = document.createElement("a");
      open.className = "open-material";
      open.href = url;
      open.target = "_blank";
      open.rel = "noopener noreferrer";
      open.textContent = "Buka Materi ↗";
      actions.appendChild(open);
    }

    if ((activeRole === "guru" || activeRole === "admin") &&
        activeUser && item.ownerUid === activeUser.uid) {
      const del = document.createElement("button");
      del.className = "delete-material";
      del.type = "button";
      del.textContent = "Hapus";
      del.addEventListener("click", () => hapusMateri(item.id));
      actions.appendChild(del);
    }
    if (actions.children.length) card.appendChild(actions);
    list.appendChild(card);
  });
}

$("materialForm").addEventListener("submit", async event => {
  event.preventDefault();
  if (!activeUser || !["guru", "admin"].includes(activeRole)) {
    $("materialError").textContent = "Login sebagai guru yang disetujui diperlukan.";
    return;
  }

  const judul = $("judulMateri").value.trim();
  const deskripsi = $("deskripsiMateri").value.trim();
  const link = safeUrl($("linkMateri").value.trim());
  if (!judul || !deskripsi || !link) {
    $("materialError").textContent = "Lengkapi semua kolom dengan tautan HTTP/HTTPS yang valid.";
    return;
  }

  const button = $("saveMaterialButton");
  button.disabled = true;
  button.textContent = "Menyimpan...";
  $("materialError").textContent = "";
  $("materialError").className = "error";

  try {
    await addDoc(collection(db, "materials"), {
      judul, deskripsi, link,
      ownerUid: activeUser.uid,
      pembuat: activeUser.displayName || activeUser.email || "Guru",
      createdAt: serverTimestamp()
    });
    $("materialForm").reset();
    $("materialError").className = "success";
    $("materialError").textContent = "Materi berhasil disimpan.";
  } catch (error) {
    console.error(error);
    $("materialError").textContent = "Materi gagal disimpan. Periksa Firestore Rules.";
  } finally {
    button.disabled = false;
    button.textContent = "Simpan Materi";
  }
});

async function hapusMateri(id) {
  if (!activeUser || !["guru", "admin"].includes(activeRole)) return;
  const item = materials.find(m => m.id === id);
  if (!item || item.ownerUid !== activeUser.uid) {
    $("materialError").textContent = "Kamu hanya dapat menghapus materi milikmu sendiri.";
    return;
  }
  if (!confirm("Yakin ingin menghapus materi ini?")) return;
  try {
    await deleteDoc(doc(db, "materials", id));
    $("materialError").className = "success";
    $("materialError").textContent = "Materi berhasil dihapus.";
  } catch (error) {
    $("materialError").className = "error";
    $("materialError").textContent = "Materi gagal dihapus. Periksa Firestore Rules.";
  }
}

// ===== PENGELOLAAN GURU KHUSUS ADMIN =====

function statusLabel(status) {
  const map = {
    pending: ["Menunggu", "pending-tag"],
    approved: ["Disetujui", "approved-tag"],
    rejected: ["Ditolak", "rejected-tag"],
    disabled: ["Dinonaktifkan", "disabled-tag"]
  };
  return map[status] || ["Status tidak diketahui", "disabled-tag"];
}

function teacherCard(profile, uid, mode) {
  const row = document.createElement("article");
  row.className = "teacher-row";

  const title = document.createElement("h3");
  title.textContent = profile.nama || "Nama belum diisi";
  const email = document.createElement("p");
  email.textContent = profile.email || "Email tidak tersedia";
  const status = document.createElement("span");
  const [label, css] = statusLabel(profile.status);
  status.className = css;
  status.textContent = label;
  row.append(title, email, status);

  const actions = document.createElement("div");
  actions.className = "teacher-actions";

  function addAction(text, css, nextStatus, confirmText) {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = css;
    btn.textContent = text;
    btn.addEventListener("click", async () => {
      if (!confirm(confirmText)) return;
      btn.disabled = true;
      try {
        await updateDoc(doc(db, "users", uid), {
          status: nextStatus,
          updatedAt: serverTimestamp()
        });
        await loadTeachers();
      } catch (error) {
        console.error(error);
        alert("Status gagal diubah. Periksa Firestore Rules dan koneksi.");
      } finally {
        btn.disabled = false;
      }
    });
    actions.appendChild(btn);
  }

  if (mode === "approval") {
    if (profile.status === "pending") {
      addAction("✓ Terima", "approve-btn", "approved", "Setujui pendaftaran guru ini?");
      addAction("✕ Tolak", "reject-btn", "rejected", "Tolak pendaftaran guru ini?");
    } else if (profile.status === "rejected") {
      addAction("Terima Guru", "approve-btn", "approved", "Terima guru ini?");
    }
  } else {
    if (profile.status === "approved") {
      addAction("Nonaktifkan", "disable-btn", "disabled", "Nonaktifkan akses guru ini?");
      addAction("Tolak Akses", "reject-btn", "rejected", "Ubah status guru ini menjadi ditolak?");
    } else if (profile.status === "disabled" || profile.status === "rejected") {
      addAction("Aktifkan Kembali", "approve-btn", "approved", "Aktifkan kembali akses guru ini?");
    } else if (profile.status === "pending") {
      addAction("✓ Terima", "approve-btn", "approved", "Setujui pendaftaran guru ini?");
      addAction("✕ Tolak", "reject-btn", "rejected", "Tolak pendaftaran guru ini?");
    }
  }

  if (actions.children.length) row.appendChild(actions);
  return row;
}

async function loadTeachers() {
  if (activeRole !== "admin") return;
  $("pendingTeachers").replaceChildren();
  $("allTeachers").replaceChildren();

  try {
    const snapshot = await getDocs(collection(db, "users"));
    teacherProfiles = snapshot.docs
      .map(d => ({ uid: d.id, ...d.data() }))
      .filter(p => p.role === "guru");

    const pending = teacherProfiles.filter(p => p.status === "pending");
    const approved = teacherProfiles.filter(p => p.status === "approved");
    const rejected = teacherProfiles.filter(p => ["rejected", "disabled"].includes(p.status));

    $("countApproved").textContent = approved.length;
    $("countPending").textContent = pending.length;
    $("countRejected").textContent = rejected.length;

    if (!pending.length) {
      const empty = document.createElement("div");
      empty.className = "empty-state";
      empty.textContent = "Tidak ada pendaftaran guru yang menunggu persetujuan.";
      $("pendingTeachers").appendChild(empty);
    } else {
      pending.forEach(p => $("pendingTeachers").appendChild(teacherCard(p, p.uid, "approval")));
    }

    if (!teacherProfiles.length) {
      const empty = document.createElement("div");
      empty.className = "empty-state";
      empty.textContent = "Belum ada akun guru terdaftar.";
      $("allTeachers").appendChild(empty);
    } else {
      teacherProfiles.sort((a, b) => (a.nama || "").localeCompare(b.nama || "", "id"));
      teacherProfiles.forEach(p => $("allTeachers").appendChild(teacherCard(p, p.uid, "management")));
    }
  } catch (error) {
    console.error("Gagal memuat daftar guru:", error);
    const message = document.createElement("div");
    message.className = "empty-state";
    message.textContent = "Daftar guru gagal dimuat. Pastikan akun ini admin dan Firestore Rules sudah diterbitkan.";
    $("pendingTeachers").appendChild(message);
    $("allTeachers").appendChild(message.cloneNode(true));
  }
}

function bukaPengelolaanGuru(mode) {
  if (activeRole !== "admin") {
    alert("Menu ini hanya dapat dibuka oleh admin.");
    return;
  }
  showPage(mode === "approval" ? "approvalPage" : "teacherManagementPage");
  loadTeachers();
}

// Pulihkan sesi dan periksa status setiap kali login/refresh.
onAuthStateChanged(auth, async user => {
  if (registering) return;

  const check = ++sessionCheck;
  if (!user) {
    if (activeRole === "guru" || activeRole === "admin") {
      clearSession();
      showPage("home");
    }
    return;
  }

  try {
    const result = await verifyAccount(user);
    if (check !== sessionCheck) return;

    activeUser = user;
    activeRole = result.role;
    studentName = "";
    buildDashboard();
    startMaterialsListener();
  } catch (error) {
    if (check !== sessionCheck) return;
    console.error("Akun tidak dapat masuk:", error);
    const message = error.message || "Akun belum dapat digunakan.";
    await signOut(auth).catch(() => {});
    clearSession();
    selectedRole = "guru";
    showRoleForm("guru");
    showError(message);
  }
});

showPage("home");
